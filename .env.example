# BARLOS sozlamalari. Bu faylni ".env" nomi bilan nusxalang va to'ldiring.
PORT=3000

# Faqat Docker + Caddy bilan internetga chiqarganda: saytingiz domeni (masalan barlos.uz)
DOMAIN=sizning-domeningiz.uz

# Administrator emaili (shu email bilan kirgan odam admin bo'ladi)
ADMIN_EMAIL=eldoristamov381@gmail.com
# Ixtiyoriy: server birinchi marta ishga tushganda admin parolini shu yerdan oladi.
# (Yoki "npm run setup" bilan parolni terminalda kiriting. Xavfsizroq.)
# ADMIN_PASSWORD=

# Ma'lumotlar bazasi saqlanadigan papka (Docker'da /data)
# DATA_DIR=./data

# CoinMarketCap API kaliti (https://pro.coinmarketcap.com, bepul reja bor). Bo'sh bo'lsa CoinGecko ishlatiladi.
CMC_API_KEY=

# Bitget shaxsiy API kaliti (ixtiyoriy). Faqat "Read-only" (o'qish) ruxsati bilan yarating, Trade/Withdraw yoqmang.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# Binance (asosiy narx/tarix manbasi). Standart: data-api.binance.vision, keyin api.binance.com. Kalit kerak emas.
# BINANCE_HOSTS=https://data-api.binance.vision,https://api.binance.com
# Yangilash jadvali (standart): Binance narx/shamlari har 5 daqiqada, Excel/havola tarixi har 2 soatda.
# CRYPTO_SYNC_MIN=5
# HIST_HOURS=2

# Google Apps Script o'tkazgichi (Bitget/Yahoo provayder tomonidan to'silgan bo'lsa). Qo'llanmadagi 2.5.0 bo'limiga qarang.
RELAY_URL=
RELAY_KEY=

# Email yuborish (ixtiyoriy). To'ldirilsa: ro'yxatdan o'tishda email tasdiqlanadi va parolni tiklash kodi yuboriladi.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BARLOS <no-reply@sizning-domeningiz.uz>

# HTTPS orqasida ishlayotgan bo'lsa true (Caddy/Render avtomatik aniqlanadi)
# COOKIE_SECURE=true
